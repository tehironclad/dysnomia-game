[physics]

3d/physics_engine="Jolt Physics"

[rendering]
textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
global_illumination/sdfgi/probe_ray_count=2
environment/ssao/quality=2
environment/ssil/quality=2
environment/subsurface_scattering/subsurface_scattering_quality=1
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.08, 1)
